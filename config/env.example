# Example environment variables (copy to your own local env file later)

# API Application Settings
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Production overrides (set in deployment environment)
# ENVIRONMENT=production
# LOG_LEVEL=WARNING

# API CORS (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:3000

# API JWT Settings
JWT_SECRET=dev-change-me
JWT_ISSUER=fullstack-template
JWT_AUDIENCE=fullstack-template
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (can use DATABASE_URL or individual POSTGRES_* vars)
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Storage providers
STORAGE_PROVIDER=s3
S3_BUCKET=uploads
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_URL_EXPIRES_SECONDS=900

# GCS (to be implemented)
GCS_BUCKET=
# AZURE (to be implemented)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=

# Email (dev sink)
EMAIL_ENABLED=true
EMAIL_FROM_ADDRESS=no-reply@local
EMAIL_FROM_NAME=Fullstack Template
EMAIL_WEB_BASE_URL=http://localhost:3000
EMAIL_SUPPORT_ADDRESS=support@local
EMAIL_LOG_PAYLOAD=true
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# Database Migration Safety (production)
# MIGRATION_BACKUP_REQUIRED=true
# MIGRATION_ALLOW_DESTRUCTIVE=false

# GitHub Container Registry (for CI/CD)
# GHCR_TOKEN=<github-personal-access-token>

# Production Database (set in deployment secrets)
# DATABASE_URL=<production-database-url>
# Example for AWS RDS: postgresql+psycopg://user:password@your-rds-endpoint.amazonaws.com:5432/dbname
