# Local x-to-demo environment

# API
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# OpenAI / x-to-demo pipeline
OPENAI_API_KEY=
X_TO_DEMO_MODEL=gpt-5.1
X_TO_DEMO_OUTPUT_DIR=artifacts/x-to-demo
X_TO_DEMO_MAX_INPUT_CHARS=60000
