#!/usr/bin/env bash
# Interactive prompts for key deployment variables. Writes .env.production.
# Optional: run after bootstrap when you're ready to deploy. Local dev does not need this.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

OUTPUT_FILE=".env.production"

log() { printf "==> %s\n" "$1"; }
warn() { printf "warning: %s\n" "$1" >&2; }

prompt_value() {
  local -n ref=$1
  local prompt="$2" default="$3"
  read -r -p "${prompt} [${default}]: " ref
  ref="${ref:-$default}"
}

# Project name for JWT/email defaults
APP_NAME="$(python3 -c "
import json
from pathlib import Path
p = Path('package.json')
print(json.loads(p.read_text()).get('name', 'my-app') if p.exists() else 'my-app')
" 2>/dev/null || echo "my-app")"

if [[ ! -t 0 ]]; then
  echo "Configure-deploy is interactive. Run from a TTY, or create .env.production from config/env.example and docs/deployment.md." >&2
  exit 1
fi

echo "Key deployment variables (all optional — press Enter to skip or use default)."
echo "Used for .env.production and manual/CI deployment. Local dev uses .env only."
echo ""

prompt_value DATABASE_URL "Production DATABASE_URL (e.g. postgresql+psycopg://user:pass@host:5432/db)" ""
prompt_value JWT_SECRET "JWT_SECRET (production)" ""
prompt_value JWT_ISSUER "JWT_ISSUER" "$APP_NAME"
prompt_value JWT_AUDIENCE "JWT_AUDIENCE" "$APP_NAME"
prompt_value CORS_ORIGINS "CORS_ORIGINS (e.g. https://your-app.com)" ""
prompt_value NEXT_PUBLIC_API_URL "NEXT_PUBLIC_API_URL (e.g. https://api.your-app.com/api/v1)" ""
prompt_value EMAIL_WEB_BASE_URL "EMAIL_WEB_BASE_URL (e.g. https://your-app.com)" ""
prompt_value EMAIL_FROM_ADDRESS "EMAIL_FROM_ADDRESS" ""
prompt_value EMAIL_FROM_NAME "EMAIL_FROM_NAME" "$APP_NAME"
prompt_value EMAIL_SUPPORT_ADDRESS "EMAIL_SUPPORT_ADDRESS" ""
prompt_value S3_BUCKET "S3_BUCKET (production)" ""
prompt_value S3_REGION "S3_REGION" "us-east-1"
prompt_value S3_ACCESS_KEY_ID "S3_ACCESS_KEY_ID" ""
prompt_value S3_SECRET_ACCESS_KEY "S3_SECRET_ACCESS_KEY" ""

if [[ -f "$OUTPUT_FILE" ]]; then
  read -r -p "Overwrite existing $OUTPUT_FILE? [y/N]: " overwrite
  if [[ ! "${overwrite:-n}" =~ ^[yY] ]]; then
    log "Leaving $OUTPUT_FILE unchanged."
    exit 0
  fi
fi

# Build .env.production (required production settings + prompted values)
{
  echo "# Production environment — generated by scripts/configure-deploy"
  echo "# Edit as needed; do not commit secrets (see .gitignore)."
  echo ""
  echo "ENVIRONMENT=production"
  echo "LOG_LEVEL=WARNING"
  echo "API_HOST=0.0.0.0"
  echo "API_PORT=8000"
  echo "JWT_ALGORITHM=HS256"
  echo "JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30"
  echo ""
  echo "# Database (set in deployment or GitHub secret PRODUCTION_DATABASE_URL for CI)"
  [[ -n "$DATABASE_URL" ]] && echo "DATABASE_URL=$DATABASE_URL" || echo "# DATABASE_URL="
  echo ""
  echo "# JWT"
  echo "JWT_SECRET=${JWT_SECRET:-}"
  echo "JWT_ISSUER=$JWT_ISSUER"
  echo "JWT_AUDIENCE=$JWT_AUDIENCE"
  echo ""
  echo "# CORS"
  echo "CORS_ORIGINS=${CORS_ORIGINS:-}"
  echo ""
  echo "# Web"
  echo "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-}"
  echo ""
  echo "# Email"
  echo "EMAIL_ENABLED=true"
  echo "EMAIL_FROM_ADDRESS=${EMAIL_FROM_ADDRESS:-}"
  echo "EMAIL_FROM_NAME=$EMAIL_FROM_NAME"
  echo "EMAIL_WEB_BASE_URL=${EMAIL_WEB_BASE_URL:-}"
  echo "EMAIL_SUPPORT_ADDRESS=${EMAIL_SUPPORT_ADDRESS:-}"
  echo ""
  echo "# Storage (S3)"
  echo "STORAGE_PROVIDER=s3"
  echo "S3_BUCKET=${S3_BUCKET:-}"
  echo "S3_REGION=$S3_REGION"
  [[ -n "$S3_ACCESS_KEY_ID" ]] && echo "S3_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID" || echo "# S3_ACCESS_KEY_ID="
  [[ -n "$S3_SECRET_ACCESS_KEY" ]] && echo "S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY" || echo "# S3_SECRET_ACCESS_KEY="
  echo ""
  echo "# UPLOAD_MAX_SIZE_BYTES=10485760"
  echo "# UPLOAD_URL_EXPIRES_SECONDS=900"
} > "$OUTPUT_FILE"

log "Wrote $OUTPUT_FILE"

echo ""
echo "For GitHub Actions CI/CD, set repository secrets:"
echo "  - PRODUCTION_DATABASE_URL  (production PostgreSQL connection string)"
echo "See docs/deployment.md for manual deploy and .env.production usage."
