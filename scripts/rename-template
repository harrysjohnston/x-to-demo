#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'EOF'
Usage: scripts/rename-template <project-name> [--dry-run]

Renames template identifiers from "fullstack-template" to the project name.

Arguments:
  project-name    Lowercase slug (letters, numbers, hyphens)

Options:
  --dry-run       Show planned changes without writing files
  -h, --help      Show this help
EOF
}

DRY_RUN=false
PROJECT_NAME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [[ -z "$PROJECT_NAME" ]]; then
        PROJECT_NAME="$1"
        shift
      else
        echo "Unexpected argument: $1" >&2
        usage
        exit 1
      fi
      ;;
  esac
done

if [[ -z "$PROJECT_NAME" ]]; then
  usage
  exit 1
fi

PROJECT_NAME_LOWER="$(echo "$PROJECT_NAME" | tr '[:upper:]' '[:lower:]')"
if [[ "$PROJECT_NAME" != "$PROJECT_NAME_LOWER" ]]; then
  echo "warning: project name converted to lowercase: $PROJECT_NAME_LOWER" >&2
  PROJECT_NAME="$PROJECT_NAME_LOWER"
fi

if ! [[ "$PROJECT_NAME" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
  echo "project-name must be lowercase letters, numbers, or hyphens" >&2
  exit 1
fi

if [[ "$PROJECT_NAME" == "fullstack-template" ]]; then
  echo "project-name is already fullstack-template; nothing to rename" >&2
  exit 1
fi

python3 - "$ROOT_DIR" "$PROJECT_NAME" "$DRY_RUN" <<'PY'
from __future__ import annotations

import sys
from pathlib import Path

root_dir = Path(sys.argv[1])
project_name = sys.argv[2]
dry_run = sys.argv[3].lower() == "true"

replacements = [
    ("fullstack-template-api", f"{project_name}-api"),
    ("fullstack-template-web", f"{project_name}-web"),
    ("fullstack-template-production", f"{project_name}-production"),
    ("fullstack-template-dev-cluster", f"{project_name}-dev-cluster"),
    ("fullstack-template-dev-api", f"{project_name}-dev-api"),
    ("fullstack-template-dev-web", f"{project_name}-dev-web"),
    ("fullstack-template API", f"{project_name} API"),
    ("Fullstack Template", project_name),
    ("fullstack-template", project_name),
]

files = [
    "package.json",
    "README.md",
    "docker-compose.yml",
    "config/env.example",
    "apps/api/app/config.py",
    "apps/api/tests/test_health.py",
    "apps/web/app/page.tsx",
    "apps/web/app/page.test.tsx",
    "apps/web/tests-e2e/homepage.spec.ts",
    ".github/workflows/ci.yml",
    "docs/deployment.md",
    "infra/README.md",
    "infra/terraform/terraform.tfvars.example",
    "infra/terraform/variables.tf",
    "infra/terraform/backend.tf",
    ".cursor/rules/python-venv.mdc",
    "Plans.md",
]

missing = []
changed = 0

for rel_path in files:
    path = root_dir / rel_path
    if not path.exists():
        missing.append(rel_path)
        continue

    contents = path.read_text(encoding="utf-8")
    updated = contents
    replacements_applied = 0
    for old, new in replacements:
        if old in updated:
            count = updated.count(old)
            replacements_applied += count
            updated = updated.replace(old, new)

    if updated != contents:
        changed += 1
        if dry_run:
            print(f"[dry-run] {rel_path}: {replacements_applied} replacements")
        else:
            path.write_text(updated, encoding="utf-8")
            print(f"updated {rel_path} ({replacements_applied} replacements)")

if missing:
    print("warning: missing files:", ", ".join(missing), file=sys.stderr)

if changed == 0:
    print("No changes were necessary.")
elif dry_run:
    print(f"{changed} files would be updated.")
else:
    print(f"{changed} files updated.")
PY
