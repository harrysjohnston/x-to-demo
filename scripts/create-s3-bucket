#!/usr/bin/env python3
"""Create S3/MinIO bucket if it doesn't exist.

This script reads configuration from .env and creates the bucket
if it doesn't already exist. Used during bootstrap to set up storage.
"""

import os
import sys
import time
from pathlib import Path

try:
    import boto3
    from botocore.client import Config
    from botocore.exceptions import ClientError
except ImportError:
    print("Error: boto3 is required. Install with: uv pip install boto3", file=sys.stderr)
    sys.exit(1)


def load_env_file(env_path: Path) -> dict[str, str]:
    """Load environment variables from .env file."""
    env_vars = {}
    if not env_path.exists():
        return env_vars

    with env_path.open() as f:
        for line in f:
            line = line.strip()
            # Skip comments and empty lines
            if not line or line.startswith("#"):
                continue
            # Parse KEY=VALUE
            if "=" in line:
                key, value = line.split("=", 1)
                env_vars[key.strip()] = value.strip()
    return env_vars


def create_bucket_if_not_exists(
    bucket_name: str,
    endpoint_url: str | None = None,
    access_key_id: str | None = None,
    secret_access_key: str | None = None,
    region: str = "us-east-1",
    max_retries: int = 5,
    retry_delay: int = 2,
) -> bool:
    """Create S3 bucket if it doesn't exist.

    Args:
        bucket_name: Name of the bucket to create
        endpoint_url: S3 endpoint URL (for MinIO)
        access_key_id: AWS access key ID
        secret_access_key: AWS secret access key
        region: AWS region
        max_retries: Maximum number of retries if connection fails
        retry_delay: Delay between retries in seconds

    Returns:
        True if bucket was created or already exists, False on error.
    """
    # Create S3 client
    client_kwargs: dict[str, str | Config] = {}
    if endpoint_url:
        client_kwargs["endpoint_url"] = endpoint_url
    if access_key_id and secret_access_key:
        client_kwargs["aws_access_key_id"] = access_key_id
        client_kwargs["aws_secret_access_key"] = secret_access_key

    # Use path-style addressing for MinIO compatibility
    if endpoint_url:
        client_kwargs["config"] = Config(
            signature_version="s3v4", s3={"addressing_style": "path"}
        )

    s3_client = boto3.client("s3", region_name=region, **client_kwargs)

    # Retry logic for connection issues (e.g., MinIO not ready yet)
    for attempt in range(max_retries):
        try:
            # Check if bucket exists
            s3_client.head_bucket(Bucket=bucket_name)
            print(f"Bucket '{bucket_name}' already exists")
            return True
        except ClientError as e:
            error_code = e.response.get("Error", {}).get("Code", "")
            if error_code == "404":
                # Bucket doesn't exist, create it
                try:
                    if endpoint_url:
                        # MinIO: create bucket without location constraint
                        s3_client.create_bucket(Bucket=bucket_name)
                    else:
                        # AWS S3: may need location constraint
                        s3_client.create_bucket(
                            Bucket=bucket_name,
                            CreateBucketConfiguration={"LocationConstraint": region}
                            if region != "us-east-1"
                            else {},
                        )
                    print(f"Created bucket '{bucket_name}'")
                    return True
                except ClientError as create_error:
                    error_msg = str(create_error)
                    # Check if it's a connection error (MinIO not ready)
                    if "Connection" in error_msg or "timeout" in error_msg.lower():
                        if attempt < max_retries - 1:
                            print(
                                f"MinIO not ready yet, retrying in {retry_delay}s... ({attempt + 1}/{max_retries})",
                                file=sys.stderr,
                            )
                            time.sleep(retry_delay)
                            continue
                    print(
                        f"Error creating bucket '{bucket_name}': {create_error}",
                        file=sys.stderr,
                    )
                    return False
            elif error_code in ("403", "AccessDenied"):
                print(
                    f"Access denied to bucket '{bucket_name}'. Check credentials.",
                    file=sys.stderr,
                )
                return False
            else:
                # Connection errors - retry
                error_msg = str(e)
                if "Connection" in error_msg or "timeout" in error_msg.lower():
                    if attempt < max_retries - 1:
                        print(
                            f"Connection error, retrying in {retry_delay}s... ({attempt + 1}/{max_retries})",
                            file=sys.stderr,
                        )
                        time.sleep(retry_delay)
                        continue
                print(f"Error checking bucket '{bucket_name}': {e}", file=sys.stderr)
                return False
        except Exception as e:
            # Other exceptions (network errors, etc.)
            error_msg = str(e)
            if attempt < max_retries - 1:
                print(
                    f"Connection error, retrying in {retry_delay}s... ({attempt + 1}/{max_retries})",
                    file=sys.stderr,
                )
                time.sleep(retry_delay)
                continue
            print(f"Unexpected error: {e}", file=sys.stderr)
            return False

    print(f"Failed to connect to storage after {max_retries} attempts", file=sys.stderr)
    return False


def main() -> int:
    """Main entry point."""
    # Get root directory (parent of scripts/)
    root_dir = Path(__file__).parent.parent
    env_path = root_dir / ".env"

    # Load environment variables
    env_vars = load_env_file(env_path)

    # Get configuration (with defaults matching env.example)
    bucket_name = env_vars.get("S3_BUCKET", "uploads")
    endpoint_url = env_vars.get("S3_ENDPOINT_URL") or None
    access_key_id = env_vars.get("S3_ACCESS_KEY_ID") or None
    secret_access_key = env_vars.get("S3_SECRET_ACCESS_KEY") or None
    region = env_vars.get("S3_REGION", "us-east-1")

    if not bucket_name:
        print("Error: S3_BUCKET is not set", file=sys.stderr)
        return 1

    # Only create bucket if using S3 storage provider
    storage_provider = env_vars.get("STORAGE_PROVIDER", "s3").lower()
    if storage_provider != "s3":
        print(f"Skipping bucket creation (storage provider is '{storage_provider}')")
        return 0

    # Create bucket
    success = create_bucket_if_not_exists(
        bucket_name=bucket_name,
        endpoint_url=endpoint_url,
        access_key_id=access_key_id,
        secret_access_key=secret_access_key,
        region=region,
    )

    return 0 if success else 1


if __name__ == "__main__":
    sys.exit(main())
