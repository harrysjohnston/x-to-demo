#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

usage() {
  cat <<'USAGE'
Usage: scripts/ci-local [--pre-commit|--checks]

Runs the retained CI jobs locally.

  --checks      Run lint, typecheck, and tests (default)
  --pre-commit  Run pre-commit on all files
USAGE
}

RUN_CHECKS=true
RUN_PRECOMMIT=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --checks)
      RUN_CHECKS=true
      RUN_PRECOMMIT=false
      shift
      ;;
    --pre-commit)
      RUN_CHECKS=false
      RUN_PRECOMMIT=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

pnpm install --no-frozen-lockfile

if [[ "$RUN_CHECKS" == "true" ]]; then
  pnpm lint:ci
  pnpm typecheck
  pnpm test
fi

if [[ "$RUN_PRECOMMIT" == "true" ]]; then
  uv run --project apps/api --extra dev python -m pre_commit run --all-files --show-diff-on-failure
fi
