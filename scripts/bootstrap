#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

usage() {
  cat <<'USAGE'
Usage: scripts/bootstrap [--skip-install] [--skip-checks]

Bootstraps local x-to-demo development:
  1) Creates .env from config/env.example if missing
  2) Installs workspace dependencies
  3) Runs lint/typecheck/tests unless skipped
USAGE
}

SKIP_INSTALL=false
SKIP_CHECKS=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --skip-install)
      SKIP_INSTALL=true
      shift
      ;;
    --skip-checks)
      SKIP_CHECKS=true
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ ! -f .env ]]; then
  cp config/env.example .env
  echo "Created .env from config/env.example"
else
  echo ".env already exists"
fi

if [[ "$SKIP_INSTALL" == "false" ]]; then
  pnpm install
  uv sync --project apps/api --extra dev
fi

if [[ "$SKIP_CHECKS" == "false" ]]; then
  pnpm lint
  pnpm typecheck
  pnpm test
fi

echo "Bootstrap complete. Start services with: pnpm dev"
