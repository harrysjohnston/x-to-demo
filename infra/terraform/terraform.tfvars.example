# Terraform Variables Example
# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to git (it may contain secrets)

# -----------------------------------------------------------------------------
# General Configuration
# -----------------------------------------------------------------------------

project_name = "fullstack-template"
aws_region   = "us-east-1"

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

db_name     = "app"
db_username = "app"
db_password = "CHANGE_ME_use_a_strong_password"

# -----------------------------------------------------------------------------
# Container Images
# -----------------------------------------------------------------------------
# Update OWNER with your GitHub username or organization

api_image = "ghcr.io/OWNER/fullstack-template-api:latest"
web_image = "ghcr.io/OWNER/fullstack-template-web:latest"

# Optional: GHCR credentials for private image pulls
# ghcr_username = "your-github-username"
# ghcr_token    = "ghp_..."

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# S3 bucket names must be globally unique

s3_bucket_name = "your-unique-bucket-name-uploads"

# Optional: Explicit S3 credentials (leave empty to use IAM roles)
# s3_access_key_id     = ""
# s3_secret_access_key = ""

# -----------------------------------------------------------------------------
# Security / Secrets
# -----------------------------------------------------------------------------

jwt_secret   = "CHANGE_ME_use_a_long_random_string"
jwt_issuer   = "fullstack-template"
jwt_audience = "fullstack-template"

# Optional: set to 0 to pause ECS services via Terraform
# ecs_desired_count_override = 0
# ecs_ignore_desired_count   = false

# -----------------------------------------------------------------------------
# CORS / Domain
# -----------------------------------------------------------------------------
# For production, update these to your actual domain

cors_origins = ["https://your-domain.com"]

# HTTPS Configuration (optional)
# First, create an ACM certificate for your domain
# certificate_arn = "arn:aws:acm:us-east-1:123456789:certificate/abc-123"
# enable_https    = true

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------

email_from_address = "no-reply@your-domain.com"
email_from_name    = "Fullstack Template"
email_web_base_url = "https://your-domain.com"

# -----------------------------------------------------------------------------
# Web App
# -----------------------------------------------------------------------------
# Update to your API endpoint

next_public_api_url = "https://api.your-domain.com/api/v1"
