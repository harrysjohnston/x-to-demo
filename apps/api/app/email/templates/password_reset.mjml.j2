<mjml>
  <mj-body background-color="#ffffff">
    <mj-section>
      <mj-column>
        <mj-text font-size="20px" font-weight="bold">
          Reset your {{ app_name }} password
        </mj-text>
        <mj-text>
          {% if user_name %}Hi {{ user_name }},{% else %}Hi there,{% endif %}
        </mj-text>
        <mj-text>
          We received a request to reset your password. Use the button below to set a new one.
        </mj-text>
        <mj-button href="{{ reset_url }}">Reset password</mj-button>
        <mj-text font-size="12px" color="#666666">
          If you did not request this, contact us at {{ support_email }}.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
